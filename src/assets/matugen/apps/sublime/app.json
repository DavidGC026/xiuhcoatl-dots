{
  "name": "Sublime Text",
  "category": "editors",
  "icon": "",
  "hint": "select_in_app",
  "detect": {
    "bin": [
      "subl",
      "sublime_text"
    ]
  },
  "templates": [
    {
      "input": "Xiuhcoatl.sublime-color-scheme",
      "output": "$XDG_CONFIG_HOME/sublime-text/Packages/User/Xiuhcoatl.sublime-color-scheme"
    }
  ]
}
