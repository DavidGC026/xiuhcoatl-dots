{
  "name": "Zellij",
  "category": "tools",
  "icon": "",
  "detect": {
    "bin": [
      "zellij"
    ]
  },
  "templates": [
    {
      "input": "xiuhcoatl.kdl",
      "output": "$XDG_CONFIG_HOME/zellij/themes/xiuhcoatl.kdl"
    }
  ],
  "integrate": [
    {
      "type": "line",
      "file": "$XDG_CONFIG_HOME/zellij/config.kdl",
      "line": "theme \"xiuhcoatl\"",
      "comment": "//",
      "disable": "^theme\\s+\"",
      "create": true
    }
  ]
}
