{
  "name": "Helix",
  "category": "editors",
  "icon": "󰘧",
  "hint": "helix",
  "detect": {
    "bin": [
      "hx",
      "helix"
    ]
  },
  "templates": [
    {
      "input": "xiuhcoatl.toml",
      "output": "$XDG_CONFIG_HOME/helix/themes/xiuhcoatl.toml"
