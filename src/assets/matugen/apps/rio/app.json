{
  "name": "Rio",
  "category": "terminals",
  "icon": "",
  "detect": {
    "bin": [
      "rio"
    ]
  },
  "templates": [
    {
      "input": "xiuhcoatl.toml",
      "output": "$XDG_CONFIG_HOME/rio/themes/xiuhcoatl.toml"
    }
  ],
  "integrate": [
    {
      "type": "line",
      "file": "$XDG_CONFIG_HOME/rio/config.toml",
      "section": "",
      "line": "theme = \"xiuhcoatl\"",
      "disable": "^\\s*theme\\s*=",
      "create": true
    }
  ]
}
