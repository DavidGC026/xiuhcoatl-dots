{
  "name": "Wofi",
  "category": "tools",
  "icon": "󰍉",
  "detect": {
    "bin": [
      "wofi"
    ]
  },
  "templates": [
    {
      "input": "xiuhcoatl.css",
      "output": "$XDG_CONFIG_HOME/wofi/xiuhcoatl.css"
    }
  ],
  "integrate": [
    {
      "type": "line",
      "file": "$XDG_CONFIG_HOME/wofi/style.css",
      "line": "@import url(\"file://$XDG_CONFIG_HOME/wofi/xiuhcoatl.css\");",
      "comment": [
        "/*",
        "*/"
      ],
      "position": "start",
      "create": true
    }
  ]
}
